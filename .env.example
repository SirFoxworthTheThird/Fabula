# Copy to `.env` and fill in whichever applies. `.env` is gitignored;
# never commit the real one.
#
# Fabula reads credentials from the environment and nowhere else — there
# is no --api-key flag anywhere, and nothing writes a key to disk. An
# already-exported variable always wins over this file, so a key you set
# in your shell is never silently shadowed.

# Any provider litellm understands. Only the one matching your --model
# is needed.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# For an OpenAI-compatible endpoint (a proxy, an aggregator, a local
# server), the key still goes in OPENAI_API_KEY and the address goes on
# the command line:
#   fabula-playtest worlds/ashgrove the_dinner \
#     --model openai/gpt-4.1-nano --api-base https://example.invalid/v1
